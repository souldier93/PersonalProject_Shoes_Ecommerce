@startuml
left to right direction
skinparam packageStyle rectangle
skinparam usecaseFontSize 11
skinparam shadowing false

actor "Guest" as Guest
actor "Stripe Gateway" as Stripe_Gateway
actor "System" as SystemActor
actor "User" as User
User --|> Guest

rectangle "Order Tracking" {
  usecase "UC-13\nTrack Order by Email + Order Code" as UC_13
  usecase "UC-19\nView Order History" as UC_19
  usecase "UC-76\nCancel Paid Order and Request Refund" as UC_76
}
Guest --> UC_13
User --> UC_19
Guest --> UC_76
User --> UC_76
UC_76 --> Stripe_Gateway
UC_76 --> SystemActor
UC_19 ..> UC_13 : <<extend>>
UC_19 ..> UC_76 : <<extend>>
@enduml
